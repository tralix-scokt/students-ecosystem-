# ==============================================================================
# E-LEARNING ECOSYSTEM (Powered by TRALIX AI) — Environment Template
# ==============================================================================
# Copy this file to `.env.local` and supply your project credentials.
# SECURITY: Never place SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY, or
# OPENROUTER_API_KEY in NEXT_PUBLIC_* variables or commit `.env.local` to git.

# Required: Supabase Project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Required: Supabase Public Anon / Publishable Key (enforces PostgreSQL RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Canonical site URL used for email verification & password reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-Only AI Gateway Provider Keys (NEVER prefix with NEXT_PUBLIC_)
# Also configure these as Supabase Edge Function secrets for `ai-gateway`:
#   supabase secrets set OPENAI_API_KEY=... OPENROUTER_API_KEY=... OPENROUTER_API_KEY_FALLBACK=...
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FALLBACK=
AI_DEFAULT_MODEL=gpt-4o-mini
AI_FALLBACK_MODEL=openai/gpt-4o-mini

# Optional Transactional Email & Web Push Integrations (Production Setup)
SMTP_HOST=
RESEND_API_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
